<root BTCPP_format="4">
  <BehaviorTree ID="PatrolMission">
    <Sequence>
      <!-- 1. Emergency stop check — highest priority -->
      <EmergencyStopCondition/>

      <!-- 2. Waiting gate — LLM-imposed pause -->
      <WaitingCondition/>

      <!-- 3. GPS fix check — halt if GPS lost -->
      <GpsFixCheck/>

      <!-- 4. Idle check — no goal in queue -->
      <IdleMonitor/>

      <!-- 5. Mission loop -->
      <KeepRunningUntilFailure>
        <Sequence>
          <!-- Stuck handling: reverse, rotate, then check if still stuck -->
          <Fallback>
            <StuckCheck/>
            <Fallback>
              <Sequence>
                <RecoveryReverse/>
                <RecoveryRotate/>
                <StuckCheck/>
              </Sequence>
              <RecoveryFailed/>
            </Fallback>
          </Fallback>

          <!-- Obstacle handling: safe → navigate, blocked → stop -->
          <Fallback>
            <Sequence>
              <AvoidanceEnabledCondition/>
              <ObstacleCheck/>
            </Sequence>
            <StopAndWait/>
          </Fallback>

          <!-- Navigation execution -->
          <NavigateToGoal goal="{target_pose}"/>
        </Sequence>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>
</root>
