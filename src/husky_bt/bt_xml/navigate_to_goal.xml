<root BTCPP_format="4">
  <BehaviorTree ID="Navigate">
    <Sequence>
      <!-- 1. Emergency stop check — highest priority -->
      <EmergencyStopCondition/>

      <!-- 2. Waiting gate — LLM-imposed pause -->
      <WaitingCondition/>

      <!-- 3. GPS fix check — halt if GPS lost -->
      <GpsFixCheck/>

      <!-- 4. Idle check — no goal in queue -->
      <IdleMonitor/>

      <!-- 5. Stuck handling: reverse, rotate, then check if still stuck -->
      <Fallback>
        <StuckCheck/>
        <Fallback>
          <Sequence>
            <RecoveryReverse/>
            <RecoveryRotate/>
            <StuckCheck/>
          </Sequence>
          <RecoveryFailed/>
        </Fallback>
      </Fallback>

      <!-- 6. Obstacle handling: safe → navigate, blocked → stop -->
      <Fallback>
        <Sequence>
          <AvoidanceEnabledCondition/>
          <ObstacleCheck/>
        </Sequence>
        <StopAndWait/>
      </Fallback>

      <!-- 7. Navigation execution -->
      <NavigateToGoal goal="{target_pose}"/>
    </Sequence>
  </BehaviorTree>
</root>
