<root BTCPP_format="4">
  <BehaviorTree ID="Navigate">
    <Sequence>
      <!-- 1. Emergency stop check — highest priority -->
      <EmergencyStopCondition/>

      <!-- 2. Waiting gate — LLM-imposed pause -->
      <WaitingCondition/>

      <!-- 3. Idle check — no goal in queue -->
      <IdleMonitor/>

      <!-- 4. Obstacle handling: safe → navigate, blocked → stop -->
      <Fallback>
        <Sequence>
          <AvoidanceEnabledCondition/>
          <ObstacleCheck/>
        </Sequence>
        <StopAndWait/>
      </Fallback>

      <!-- 5. Navigation execution -->
      <NavigateToGoal goal="{target_pose}"/>
    </Sequence>
  </BehaviorTree>
</root>
