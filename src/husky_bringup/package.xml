<?xml version="1.0"?>
<package format="3">
  <name>husky_bringup</name>
  <version>0.0.1</version>
  <description>Launch files and configs for Husky A200 navigation stack</description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>husky_nav</exec_depend>
  <exec_depend>husky_bt</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
